<?xml version="1.0"?>
<!--
  config.xml.snippet — example showing how pfSense-pkg-zapret2
  stores its settings within pfSense's main config.xml file.

  This is for documentation and development reference only.
  DO NOT manually edit config.xml on a live pfSense system unless you
  know exactly what you are doing. Use the GUI instead.

  Location on pfSense: /cf/conf/config.xml (or /conf/config.xml)

  The actual config.xml is much larger; this snippet shows only the
  relevant <installedpackages> section.
-->

<pfsense>
  <!-- ... other pfSense config sections ... -->

  <installedpackages>

    <!--
      Package metadata entry — added when the package is installed via
      pfSense package manager or manually via zapret2_install().
    -->
    <package>
      <name>zapret2</name>
      <version>1.1.0</version>
      <descr><![CDATA[Zapret2 DPI bypass — GUI management plugin]]></descr>
      <configurationfile>zapret2.xml</configurationfile>
      <filter_rule_function>zapret2_generate_rules</filter_rule_function>
      <include_file>/usr/local/pkg/zapret2/includes/zapret2.inc</include_file>
    </package>

    <!--
      Plugin configuration — written by zapret2_save_config().
      Accessed in PHP as:
        $config['installedpackages']['zapret2']['config'][0]

      Field descriptions:
        enabled              — "on" or "" (empty string)
        profile              — one of: safe | default | multidisorder | fake_disorder | wssize | custom
        divert_port          — integer 1-65535, default 990
        custom_args          — raw dvtws2 arguments (only used when profile=custom)
        debug                — "on" or "" — enables --debug flag on dvtws2
        alias_name           — pfSense Firewall Alias name (host/network/urltable type);
                               when set (and discord_enabled is off), IPFW rule 100 uses
                               table(1) — only traffic to alias IPs goes through dvtws2
        discord_enabled      — "on" or "" — adds --hostlist with Discord domains to dvtws2,
                               overrides alias_name (rule 100 uses 'any')
        discord_udp_enabled  — "on" or "" — adds IPFW rules 101-102 for Discord UDP voice/video
    -->
    <zapret2>
      <config>
        <item>
          <enabled>on</enabled>
          <profile>default</profile>
          <!-- PF is opt-in; select pf and explicitly accept its early allow rules. -->
          <firewall_backend>ipfw</firewall_backend>
          <pf_interfaces>lan</pf_interfaces>
          <pf_allow></pf_allow>
          <divert_port>990</divert_port>
          <custom_args></custom_args>
          <debug></debug>
          <alias_name></alias_name>
          <discord_enabled></discord_enabled>
          <discord_udp_enabled></discord_udp_enabled>
        </item>
      </config>
    </zapret2>

  </installedpackages>

  <!-- ... other pfSense config sections ... -->
</pfsense>
